# PostgreSQL connection string (Railway / Render / local docker-compose)
DATABASE_URL=postgresql://stagefinder:stagefinder@localhost:5432/stagefinder

# Secret used to sign session JWTs — generate one with: openssl rand -base64 32
JWT_SECRET=change-me

# Public URL of the site (used in alert emails)
APP_URL=http://localhost:3000

# Resend (https://resend.com) — leave empty in development: emails are printed to the console
RESEND_API_KEY=
EMAIL_FROM="StageFinder TN <onboarding@resend.dev>"
